                                <value>SNOMED-CT</value>
                            </terminology_id>
                            <code_string>[SNOMED-CT(2003)::271650006]</code_string>
                        </value>
                    </items>
                    <items code="at0013">
                        <value>
                            <terminology_id>
                                <value>SNOMED-CT</value>
                            </terminology_id>
